[Unit]
Description=Canary OpenTibia Server
After=network.target mariadb.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=canary
Group=canary
WorkingDirectory=/opt/otserver/canary
ExecStart=/opt/otserver/canary/canary
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
